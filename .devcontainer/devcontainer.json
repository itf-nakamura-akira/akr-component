// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/javascript-node-postgres
{
    "name": "AKR Component",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",
    "containerEnv": {
        "GOOGLE_CLOUD_PROJECT": "${localEnv:GOOGLE_CLOUD_PROJECT}"
    },
    "postAttachCommand": {
        "bun": "bun upgrade"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "editor.codeLens": true,
                "npm.packageManager": "bun",
                "npm.scriptRunner": "bun",
                "workbench.colorCustomizations": {
                    "activityBar.background": "#cf2c70",
                    "activityBar.activeBackground": "#cf2c70",
                    "activityBar.foreground": "#ececec",
                    "activityBar.inactiveForeground": "#ececec",
                    "activityBar.activeBorder": "#ececec",
                    "activityBar.activeFocusBorder": "#ececec",
                    "activityBar.border": "#cf2c70",
                    "activityBar.dropBorder": "#cf2c70"
                }
            },
            "extensions": [
                "angular.ng-template",
                "bradlc.vscode-tailwindcss",
                "eamodio.gitlens",
                "EditorConfig.EditorConfig",
                "google.gemini-cli-vscode-ide-companion",
                "Google.geminicodeassist"
            ]
        }
    },
    // Features to add to the dev container. More info: https://containers.dev/features.
    "features": {},
    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    // This can be used to network with other containers or with the host.
    // "forwardPorts": [],
    // Use 'postCreateCommand' to run commands after the container is created.
    // "postCreateCommand": "bun upgrade",
    // Configure tool-specific properties.
    // "customizations": {},
    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    "remoteUser": "root"
}
